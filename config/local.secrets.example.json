{
  "feishu": {
    "app_id": "cli_xxx", # 飞书应用 App ID
    "app_secret": "xxx", # 飞书应用 Secret
    "chat_id": "", # 兼容旧单群配置；留空时不会向该字段发送
    "chat_ids": [ # 飞书群 ID；配置多个群时会广播发送
      "oc_xxx",
      "oc_yyy"
    ],
    "folder_token": "fld_xxx", # 飞书云文档文件夹 Token
    "open_api_base": "https://open.feishu.cn" # 飞书 OpenAPI 地址
  },
  "wechat": {
    "default_account": "ai-daily", # 默认公众号账号别名
    "accounts": [
      {
        "alias": "ai-daily", # 本地公众号账号别名
        "name": "AI Daily Radar", # 公众号名称
        "app_id": "wx_xxx", # 微信公众号 AppID
        "app_secret": "xxx", # 微信公众号 AppSecret
        "author": "AI Daily Radar", # 文章作者
        "theme": "modern", # 公众号排版主题
        "color": "blue", # 公众号排版主题色
        "need_open_comment": 1, # 是否开启评论，1 开启，0 关闭
        "only_fans_can_comment": 0, # 是否仅粉丝可评论，1 是，0 否
        "publish_method": "api", # 草稿创建方式，api 表示使用公众号 API
        "chrome_profile_path": "" # Chrome 发布模式的用户资料路径，API 模式留空
      }
    ]
  }
}
