    },
    "release_analysis": {
      "label": "版本与工具解读",
      "min_chars": 1400,
      "max_chars": 2200
    },
    "migration_guide": {
      "label": "升级迁移指南",
      "min_chars": 1800,
      "max_chars": 2800
    },
    "policy_impact": {
      "label": "政策与兼容性影响",
