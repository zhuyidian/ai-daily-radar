  "visual": {
    "body_image_min": 1,
    "body_image_max": 3,
    "palette": "低饱和开发者杂志色板，以深灰、米白和克制的 Android 绿色为主",
    "style": "开发者杂志、真实 IDE 或应用截图标注、简洁架构图、迁移流程图或克制手绘线稿",
    "avoid": [
      "未经授权或变形的 Android、Google、Kotlin 品牌标志",
      "虚构的 Android Studio、Play Console 或手机界面",
      "无法运行的装饰性代码",
      "假性能数据、假基准和假版本号",
      "绿色机器人作为通用装饰",
      "霓虹赛博城市和悬浮屏幕",
      "蓝紫色通用科技渐变",
      "光滑 3D 科技物体",
      "乱码文字和密集无意义 UI"
    ]
  }
